# Copy this file to .env, then run `docker compose up --build` for local
# testing (docker-compose.yml + docker-compose.override.yml together —
# Compose merges both automatically, no extra flags needed). Every value
# below marked "dev-only placeholder" is a KNOWN, obviously-fake value —
# the app refuses to start (see backend/services/startup_safety.py) until
# you replace it with your own, even for local use. This is deliberate:
# no real secret was ever safe to ship in a public example file, so none
# is. Generate your own with the commands shown below each one; it takes
# under a minute. Every line that MUST also be changed before a real
# production deployment (docker-compose.prod.yml, Coolify) is marked
# "PRODUCTION:".
#
# .env is gitignored and must NEVER be committed.

# --- Environment ------------------------------------------------------
# ENVIRONMENT stays "production" even for local testing — on purpose.
# It is what controls the strict startup checks below (strong secrets,
# no debug mode, a real database password) and those checks behave
# identically locally and in production; nothing about them is relaxed
# for local use. ENVIRONMENT_LABEL (bottom of this file) is the separate
# setting that puts a visible banner on every page — left blank here (no
# banner for local), set on a staging deployment instead — see
# backend/services/startup_safety.py.
ENVIRONMENT=production
# Must stay "false" outside ENVIRONMENT=development — the app refuses to
# start with FLASK_DEBUG=true in any other environment, local included.
FLASK_DEBUG=false

# --- Secrets ------------------------------------------------------------
# dev-only placeholders — these exact strings are REJECTED at startup
# (StartupConfigError) by backend/services/startup_safety.py, so the app
# will not run until you replace both, even locally:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-secret-in-production
EMAIL_SERVICE_SECRET=change-this-email-secret

# --- Database -------------------------------------------------------------
POSTGRES_DB=loan_system
POSTGRES_USER=loanuser
# dev-only placeholder — rejected at startup the same way (also too
# short/obvious to pass the production password check even if it weren't
# an exact-match reject). Generate your own with the same command above.
POSTGRES_PASSWORD=changeme

# --- CEO account (seeded automatically the first time the backend
#     container starts; idempotent — safe on every later start too) ------
# Sign in locally with CEO_EMAIL / CEO_PASSWORD below, then set your own
# password when prompted (must_change_password — this still runs locally).
# CEO_PASSWORD below is a dev-only placeholder, too short to pass the
# 12-character minimum (backend/services/password_policy.py) — the seed
# step refuses and the container will not finish starting until you set
# a real password. Set CEO_NAME/CEO_EMAIL to the real CEO's actual
# name/email too before a real deployment.
CEO_NAME=Local Test CEO
CEO_EMAIL=ceo@local.test
CEO_PASSWORD=changeme
CEO_PHONE=255700000000

# --- Company branding — the real source of truth is backend/branding.py
#     and frontend/src/branding.ts; nothing here is editable in the UI ----
FRONTEND_URL=http://localhost:3000
# Optional: an externally-reachable URL for the logo (served by the
# frontend itself at /logo.png) so emails use a plain <img src> instead of
# an inline attachment — useful for payslip emails, which already carry
# the payslip PDF as their one real attachment. Leave blank to keep the
# logo embedded inline (the default, works everywhere with no setup).
LOGO_URL=http://localhost:3000/logo.png

# --- SMTP ---------------------------------------------------------------
# Local: every email the app sends is caught by Mailpit (added in
# docker-compose.override.yml) — view them at http://localhost:8025.
# Nothing here can reach a real mailbox; no real email ever leaves your
# laptop. Mailpit needs no username/password and no encryption.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_ENCRYPTION=none
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@local.test
FROM_NAME=Microfinance LMS
#
# PRODUCTION: this company's real mail server — set these instead, and
# put the real password only in the production host's own environment,
# never in any file:
#   SMTP_HOST=mail.ejmfinancial.co.tz
#   SMTP_PORT=587
#   SMTP_ENCRYPTION=tls
#   SMTP_USERNAME=<the real sending mailbox>
#   SMTP_PASSWORD=<set on the server only — never committed, never here>

# --- Misc -------------------------------------------------------------
USER_DELETION_RETENTION_DAYS=30
VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# --- Backups (Phase 6 — docker-compose.prod.yml only; local has no
#     nightly job) ---------------------------------------------------------
# How many days of nightly server-side backups to keep. This is separate
# from, and does not replace, the encrypted backup a CEO/head_manager
# downloads from the Backup page — see DEPLOYMENT.md.
BACKUP_RETENTION_DAYS=14

# --- Test environment mode (Phase 7) ---------------------------------
# Left blank for local too — no banner here. The banner/reset-script-gate
# code itself is unchanged and still fully active: set this to any label
# (e.g. "Staging") on a shared staging deployment and every page will show
# a visible banner with that exact text again, and
# scripts/reset_dev_data.py will then be allowed to run there (it still
# also requires its own --yes flag).
# PRODUCTION: leave this blank/unset — no banner, and the reset script
# refuses outright regardless of anything else.
ENVIRONMENT_LABEL=

# --- Demo/test accounts (local only) ----------------------------------
# Lets scripts/seed_demo_users.py run — it seeds one account per tier plus
# two fake borrowers, all with a known shared password, for fast manual
# testing. A dedicated opt-in flag, not ENVIRONMENT/ENVIRONMENT_LABEL
# (both are deliberately identical between local and a real deployment
# now, so neither can tell the two apart any more).
# PRODUCTION: do not set this — it does not appear anywhere in
# docker-compose.prod.yml, so the script structurally refuses to run
# against a real deployment regardless of this file's contents.
ALLOW_DEMO_SEED=true
